/*/*/playwright-report/
/test-results/
/*/*/test-results/
/blob-report/
/*/*/blob-report/
playwright/.cache/
perf/results/
*.har
*.trace.zip

# ---------------------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------------------
*.log
/logs/
/*/*/logs/
/tmp/
/*/*/tmp/
.tmp/
*.tmp
*.swp
*.swo
*~

