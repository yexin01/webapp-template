    "contracts": "openapi-typescript ../../packages/contracts/openapi.json -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.22",
    "@sentry/nextjs": "11.7.0",
    "next": "16.4.3",
    "openapi-fetch": "0.17.0",
    "posthog-js": "1.442.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@next/env": "16.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@clerk/backend": "3.26.4",
    "@clerk/testing": "2.2.52"
  }
