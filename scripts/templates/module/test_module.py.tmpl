def test_member_removed_after_context_resolution_cannot_create(
    harness: Harness, people: dict[str, Any], monkeypatch: pytest.MonkeyPatch
) -> None:
    """TEN-05, TEN-07: a removal that commits after the context was resolved is a 404, not a 500."""
    assert harness.client.get(IN_ORG, headers=people["member"]).status_code == 200  # mirrors the membership
    change_after_resolution(harness, monkeypatch, REMOVE)
    assert harness.client.post(IN_ORG, json={"name": "after removal"}, headers=people["member"]).status_code == 404
    assert superuser_query(harness.database_url, "SELECT count(*) FROM app.__module__") == [(0,)]


def test_denial_by_the_role_recheck_is_audited(
    harness: Harness, people: dict[str, Any], monkeypatch: pytest.MonkeyPatch
) -> None:
    """NT-06, NT-07: an admin downgraded after the context was resolved gets 403, audited, and nothing changes."""
    item = harness.client.post(IN_ORG, json={"name": "shared"}, headers=people["admin"]).json()
    change_after_resolution(harness, monkeypatch, DOWNGRADE)
    assert harness.client.delete(f"{IN_ORG}/{item['id']}", headers=people["admin"]).status_code == 403
    audit = superuser_query(harness.database_url, "SELECT action, target_id, outcome FROM app.audit_log")
    assert audit == [("__entity__:delete", item["id"], "denied")]
    assert superuser_query(harness.database_url, "SELECT count(*) FROM app.__module__") == [(1,)]


def test_admin_removed_after_context_resolution_cannot_delete(
    harness: Harness, people: dict[str, Any], monkeypatch: pytest.MonkeyPatch
) -> None:
    """TEN-05, ADM-01: an admin removed after the context was resolved is a non-member: 404, audited, nothing changes."""
    item = harness.client.post(IN_ORG, json={"name": "shared"}, headers=people["admin"]).json()
    change_after_resolution(harness, monkeypatch, REMOVE)
    assert harness.client.delete(f"{IN_ORG}/{item['id']}", headers=people["admin"]).status_code == 404
    audit = superuser_query(harness.database_url, "SELECT action, target_id, outcome FROM app.audit_log")
    assert audit == [("__entity__:delete", item["id"], "denied")]
    assert superuser_query(harness.database_url, "SELECT count(*) FROM app.__module__") == [(1,)]


def test_the_role_recheck_applies_the_declared_permission(
    harness: Harness, people: dict[str, Any], monkeypatch: pytest.MonkeyPatch
) -> None:
    """Granting delete to members in __ENTITY___DELETE is enough: the locked re-check applies that same permission."""
    monkeypatch.setattr(service, "__ENTITY___DELETE", replace(__ENTITY___DELETE, org_roles=ALL_ROLES))
    item = harness.client.post(IN_ORG, json={"name": "shared"}, headers=people["member"]).json()
    assert harness.client.delete(f"{IN_ORG}/{item['id']}", headers=people["member"]).status_code == 204
    assert superuser_query(harness.database_url, "SELECT count(*) FROM app.__module__") == [(0,)]


