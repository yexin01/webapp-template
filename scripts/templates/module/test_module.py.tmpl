def test_api_role_without_context_cannot_insert(harness: Harness, people: dict[str, Any]) -> None:
    harness.client.post(PERSONAL, json={"name": "provisions the user"}, headers=people["admin"])
    admin = one_id(harness.database_url, "SELECT id FROM app.users WHERE clerk_user_id = %s", "user_admin")
    with pytest.raises(psycopg.errors.InsufficientPrivilege), api_role(harness.database_url) as conn:
        conn.execute(
            "INSERT INTO app.__module__ (owner_user_id, created_by, name) VALUES (%s, %s, 'x')", (admin, admin)
        )


def test_database_requires_membership_of_the_context_organization(harness: Harness, people: dict[str, Any]) -> None:
    """DB-07: a member of another organization who sets this organization's context sees and writes nothing."""
    assert harness.client.post(IN_ORG, json={"name": "org secret"}, headers=people["admin"]).status_code == 201
    # The rival is a verified member of their own organization only.
    assert harness.client.get(f"/api/v1/orgs/{OTHER_ORG}/__path__", headers=people["rival"]).status_code == 200
    url = harness.database_url
    org = one_id(url, "SELECT id FROM app.organizations WHERE clerk_org_id = %s", ORG)
    rival = one_id(url, "SELECT id FROM app.users WHERE clerk_user_id = %s", "user_rival")
    memberships = superuser_query(url, "SELECT org_id FROM app.organization_memberships WHERE user_id = %s", (rival,))
    assert len(memberships) == 1
    assert str(memberships[0][0]) != org
    with api_role(url, user_id=rival, org_id=org) as conn:
        assert conn.execute("SELECT count(*) FROM app.__module__").fetchone() == (0,)
    with pytest.raises(psycopg.errors.InsufficientPrivilege), api_role(url, user_id=rival, org_id=org) as conn:
        conn.execute("INSERT INTO app.__module__ (org_id, created_by, name) VALUES (%s, %s, 'x')", (org, rival))
    # Without an organization context, organization rows stay out of reach too.
    with pytest.raises(psycopg.errors.InsufficientPrivilege), api_role(url, user_id=rival) as conn:
        conn.execute("INSERT INTO app.__module__ (org_id, created_by, name) VALUES (%s, %s, 'x')", (org, rival))


def test_database_keeps_personal_items_to_their_owner(harness: Harness, people: dict[str, Any]) -> None:
    """DB-07, personal branch: another user, or the owner in an organization context, sees and changes nothing."""
    item = harness.client.post(PERSONAL, json={"name": "personal secret"}, headers=people["admin"]).json()
    assert harness.client.get(PERSONAL, headers=people["outsider"]).status_code == 200  # provisions the outsider
    assert harness.client.get(IN_ORG, headers=people["admin"]).status_code == 200  # provisions the organization
    url = harness.database_url
    admin = one_id(url, "SELECT id FROM app.users WHERE clerk_user_id = %s", "user_admin")
    outsider = one_id(url, "SELECT id FROM app.users WHERE clerk_user_id = %s", "user_outsider")
    org = one_id(url, "SELECT id FROM app.organizations WHERE clerk_org_id = %s", ORG)
    for context in ({"user_id": outsider}, {"user_id": admin, "org_id": org}):
        with api_role(url, **context) as conn:
            assert conn.execute("SELECT count(*) FROM app.__module__").fetchone() == (0,), context
            assert conn.execute("DELETE FROM app.__module__ WHERE id = %s", (item["id"],)).rowcount == 0, context
    insert = "INSERT INTO app.__module__ (owner_user_id, created_by, name) VALUES (%s, %s, 'x')"
    for context in ({"user_id": outsider}, {"user_id": admin}):  # someone else's row; a forged creator
        with pytest.raises(psycopg.errors.InsufficientPrivilege), api_role(url, **context) as conn:
            conn.execute(insert, (admin, outsider))
    with api_role(url, user_id=admin) as conn:  # permitted, and nothing above changed it
        assert conn.execute("SELECT id::text FROM app.__module__").fetchall() == [(item["id"],)]


def test_database_lets_a_member_update_a_row_another_member_created(harness: Harness, people: dict[str, Any]) -> None:
    """The creator is checked on INSERT only, so granting UPDATE on the editable columns is enough to edit."""
    item = harness.client.post(IN_ORG, json={"name": "shared"}, headers=people["admin"]).json()
    assert harness.client.get(IN_ORG, headers=people["member"]).status_code == 200  # provisions the member
    url = harness.database_url
    org = one_id(url, "SELECT id FROM app.organizations WHERE clerk_org_id = %s", ORG)
    member = one_id(url, "SELECT id FROM app.users WHERE clerk_user_id = %s", "user_member")
    with api_role_with_edit_grant(url, user_id=member, org_id=org) as conn:
        renamed = conn.execute(
            "UPDATE app.__module__ SET name = 'renamed' WHERE org_id = app.ctx_org_id() AND id = %s", (item["id"],)
        )
        assert renamed.rowcount == 1


def test_database_keeps_an_update_in_the_callers_tenant(harness: Harness, people: dict[str, Any]) -> None:
    """DB-07: a row cannot be moved between the personal and the organization tenant, and other tenants' rows
    are not found."""
    personal = harness.client.post(PERSONAL, json={"name": "mine"}, headers=people["admin"]).json()
    shared = harness.client.post(IN_ORG, json={"name": "shared"}, headers=people["admin"]).json()
    url = harness.database_url
    admin = one_id(url, "SELECT id FROM app.users WHERE clerk_user_id = %s", "user_admin")
    org = one_id(url, "SELECT id FROM app.organizations WHERE clerk_org_id = %s", ORG)
    moves = (
        ({"user_id": admin}, personal["id"], "owner_user_id = NULL, org_id = %s", org),
        ({"user_id": admin, "org_id": org}, shared["id"], "org_id = NULL, owner_user_id = %s", admin),
    )
    for context, row, change, value in moves:
        with pytest.raises(psycopg.errors.InsufficientPrivilege), api_role_with_edit_grant(url, **context) as conn:
            conn.execute(f"UPDATE app.__module__ SET {change} WHERE id = %s", (value, row))
    elsewhere = (
        ({"user_id": admin, "org_id": org}, personal["id"]),  # a personal row in the organization context
        ({"user_id": admin}, shared["id"]),  # an organization row in the personal context
        ({}, shared["id"]),  # no context
    )
    for context, row in elsewhere:
        with api_role_with_edit_grant(url, **context) as conn:
            assert conn.execute("UPDATE app.__module__ SET name = 'x' WHERE id = %s", (row,)).rowcount == 0, context


def test_request_role_cannot_update_tenant_keys(harness: Harness) -> None:
    """RLS cannot keep these columns unchanged; only the absence of a column grant does."""
    for column in ("id", "org_id", "owner_user_id", "created_by", "created_at"):
        sql = "SELECT has_column_privilege('app_api', 'app.__module__', %s, 'UPDATE')"
        assert superuser_query(harness.database_url, sql, (column,)) == [(False,)], column


def test_list_reads_one_page_through_the_page_index(harness: Harness) -> None:
    """DB-02: the first page, and one halfway through a tenant, walk the page index and stop at the page size."""
    seed_tenants(harness.database_url, "__module__")
    transactions = harness.container.kernel.transactions(lambda conn: conn)
    for ctx, index in ((ORG_CONTEXT, "__module___org_page_idx"), (PERSONAL_CONTEXT, "__module___owner_page_idx")):
        for after in (None, halfway_cursor(transactions, Pg__Module__Repository, ctx)):
            path = page_plan(transactions, Pg__Module__Repository, ctx, after)
            shape = [(node["Node Type"], node.get("Index Name")) for node in path]
            assert shape == [("Limit", None), ("Index Scan", index)], (ctx.kind, after, path[0])
            # The scan stopped at the page: nothing read beyond it, nothing discarded by the policy or the cursor.
            assert (path[1]["Actual Rows"], path[1].get("Rows Removed by Filter", 0)) == (DEFAULT_PAGE_SIZE, 0), path[0]
