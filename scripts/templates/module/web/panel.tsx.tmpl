"use client";

import { useCallback, useId, useState, type FormEvent } from "react";

import type { Schemas } from "@/lib/api/client";
import { ApiError } from "@/lib/api/errors";
import { useApi } from "@/lib/api/use-api";
import { useResource } from "@/lib/use-resource";
import { EmptyState, ErrorState, LoadingState } from "@/ui/state-views";

type Props = { orgId: string | null; canDelete: boolean };
type Item = Schemas["__Entity__"];

const MAX_NAME = 120;

/** Generated by `pnpm new:module`: list, create, and delete __label__ in the active tenant. */
export function __Module__Panel({ orgId, canDelete }: Props) {
  const api = useApi();
  const inputId = useId();
  const errorId = useId();
  const fetchItems = useCallback(() => api.list__Module__(orgId), [api, orgId]);
  const items = useResource(fetchItems, `__path__:${orgId ?? "personal"}`);
  const [name, setName] = useState("");
  const [formError, setFormError] = useState<string | null>(null);
  const [busy, setBusy] = useState(false);

  async function onCreate(event: FormEvent) {
    event.preventDefault();
    const trimmed = name.trim();
    if (!trimmed || trimmed.length > MAX_NAME) {
      setFormError(`Enter a name of 1 to ${MAX_NAME} characters.`);
      return;
    }
    setBusy(true);
    setFormError(null);
    try {
      await api.create__Entity__(orgId, trimmed);
      setName("");
      items.reload();
    } catch (error) {
      setFormError(error instanceof ApiError ? error.message : "Could not create the item.");
    } finally {
      setBusy(false);
    }
  }

  async function onDelete(item: Item) {
    try {
      await api.delete__Entity__(orgId, item.id);
      items.reload();
    } catch (error) {
      setFormError(error instanceof ApiError ? error.message : "Could not delete the item.");
    }
  }

  return (
    <section className="card" aria-labelledby="__path__-title">
      <h2 id="__path__-title">__Module__</h2>
      <form className="inline-form" onSubmit={onCreate} noValidate>
        <label htmlFor={inputId}>Name</label>
        <div className="inline-form-row">
          <input
            id={inputId}
            value={name}
            maxLength={MAX_NAME}
            onChange={(e) => setName(e.target.value)}
            aria-invalid={formError ? true : undefined}
            aria-describedby={formError ? errorId : undefined}
            autoComplete="off"
          />
          <button type="submit" className="button button-primary" disabled={busy}>
            {busy ? "Creating…" : "Create"}
          </button>
        </div>
        {formError && (
          <p id={errorId} className="field-error" role="alert">
            {formError}
          </p>
        )}
      </form>
      {items.loading && <LoadingState label="Loading…" />}
      {items.error !== undefined && <ErrorState error={items.error} onRetry={items.reload} />}
      {items.data && items.data.items.length === 0 && (
        <EmptyState title="Nothing here yet">
          <p>Create the first one above.</p>
        </EmptyState>
      )}
      {items.data && items.data.items.length > 0 && (
        <ul className="list">
          {items.data.items.map((item) => (
            <li key={item.id} className="list-item">
              <span>{item.name}</span>
              {canDelete && (
                <button type="button" className="button" onClick={() => onDelete(item)}>
                  Delete<span className="visually-hidden"> {item.name}</span>
                </button>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>
  );
}
