"use client";

import { useAuth } from "@clerk/nextjs";
import { useCallback, useId, useRef, useState, type FormEvent } from "react";

import type { Schemas } from "@/lib/api/client";
import { ApiError, isInputError, presentError } from "@/lib/api/errors";
import { useApi } from "@/lib/api/use-api";
import { useActiveTenant } from "@/lib/use-active-tenant";
import { reloadPage, useClerkUnavailable, useResource } from "@/lib/use-resource";
import { EmptyState, ErrorState, LoadingState } from "@/ui/state-views";
import { focusIn, useFocusAfterRender } from "@/ui/use-focus-after-render";

type Item = Schemas["__Entity__"];
/** A failed create, delete, or load more; ErrorState presents it through presentError (FE-10). */
type Failure = { error: unknown; retry?: () => void };

const MAX_NAME = 120;

/**
 * Generated by `pnpm new:module`: list, create, and delete __label__ in the
 * active tenant; mount it as `<__Module__Panel />`. The create form and Delete are shown
 * from the list's `can`, the API's decision: no role is read here (ARCH-03). Remounts
 * per signed-in user and tenant, so no state from another user (a Clerk account
 * switch) or tenant is shown.
 */
export function __Module__Panel() {
  const { userId } = useAuth();
  const { isLoaded, orgId } = useActiveTenant();
  const clerkUnavailable = useClerkUnavailable();
  if (!isLoaded) {
    return clerkUnavailable ? (
      <ErrorState error={ApiError.authUnavailable()} onRetry={reloadPage} />
    ) : (
      <LoadingState label="Loading __label__…" />
    );
  }
  return <__Module__List key={`${userId}:${orgId ?? "personal"}`} orgId={orgId} />;
}

function __Module__List({ orgId }: { orgId: string | null }) {
  const api = useApi();
  const inputId = useId();
  const errorId = useId();
  const rowId = useId();
  const fetchFirstPage = useCallback(() => api.list__Module__(orgId), [api, orgId]);
  const first = useResource(fetchFirstPage, `__path__:${orgId ?? "personal"}`);
  const [added, setAdded] = useState<Item[]>([]);
  const [more, setMore] = useState<Item[]>([]);
  const [moreCursor, setMoreCursor] = useState<string | null | undefined>(undefined);
  const [removed, setRemoved] = useState<ReadonlySet<string>>(new Set());
  const [deleting, setDeleting] = useState<ReadonlySet<string>>(new Set());
  const [loadingMore, setLoadingMore] = useState(false);
  const [name, setName] = useState("");
  const [nameError, setNameError] = useState<string | null>(null);
  const [failure, setFailure] = useState<Failure | null>(null);
  const [busy, setBusy] = useState(false);
  // Results for screen readers (FE-09), in a live region that stays mounted so each one is read.
  const [announcement, setAnnouncement] = useState("");
  const headingRef = useRef<HTMLHeadingElement>(null);
  const loadMoreRef = useRef<HTMLButtonElement>(null);
  const failureRef = useRef<HTMLDivElement>(null);
  const deleteButtons = useRef(new Map<string, HTMLButtonElement>());
  const focusAfterRender = useFocusAfterRender();

  // The first page's decision holds for the pages after it; with no answer yet, nothing is offered.
  const can = first.data?.can;
  // An item created here can come back on a later page: list it once.
  const listed = new Set<string>();
  const items = [...added, ...(first.data?.items ?? []), ...more].filter((i) => {
    const show = !removed.has(i.id) && !listed.has(i.id);
    listed.add(i.id);
    return show;
  });
  const cursor = moreCursor === undefined ? (first.data?.next_cursor ?? null) : moreCursor;

  async function loadMore() {
    if (!cursor) return;
    // Load more is disabled while loading, and removed after the last page.
    const origin = focusIn(loadMoreRef.current);
    setLoadingMore(true);
    setFailure(null);
    try {
      const page = await api.list__Module__(orgId, cursor);
      setMore((prev) => [...prev, ...page.items]);
      setMoreCursor(page.next_cursor);
      const firstNew = page.items[0];
      if (origin) {
        focusAfterRender(
          () =>
            page.next_cursor
              ? loadMoreRef.current
              : (firstNew && deleteButtons.current.get(firstNew.id)) || headingRef.current,
          origin,
        );
      }
    } catch (error) {
      // A cursor the server refuses fails the same way when sent again: Load more goes, and
      // Try again starts over from the first page. Other failures keep Load more to retry.
      const cursorRefused = error instanceof ApiError && error.code === "INVALID_REQUEST";
      if (cursorRefused) setMoreCursor(null);
      setFailure({ error, retry: cursorRefused ? retry : undefined });
      if (origin) {
        focusAfterRender(
          () =>
            cursorRefused
              ? (failureRef.current?.querySelector("button") ?? headingRef.current)
              : loadMoreRef.current,
          origin,
        );
      }
    } finally {
      setLoadingMore(false);
    }
  }

  function retry() {
    // Try again goes away with the error it belongs to.
    headingRef.current?.focus();
    setAdded([]);
    setMore([]);
    setMoreCursor(undefined);
    setRemoved(new Set());
    setFailure(null);
    first.reload();
  }

  async function onCreate(event: FormEvent) {
    event.preventDefault();
    const trimmed = name.trim();
    // Characters as the server counts them (code points): an emoji is one, not two.
    if (!trimmed || [...trimmed].length > MAX_NAME) {
      setNameError(`Enter a name of 1 to ${MAX_NAME} characters.`);
      return;
    }
    setBusy(true);
    setNameError(null);
    setFailure(null);
    setAnnouncement("");
    try {
      const created = await api.create__Entity__(orgId, trimmed);
      setAdded((prev) => [created, ...prev]);
      setName("");
      setAnnouncement(`Created “${created.name}”.`);
    } catch (error) {
      // A rejected name belongs next to the field; the name stays there either way (FE-04).
      if (isInputError(error)) setNameError(presentError(error).message);
      else setFailure({ error });
    } finally {
      setBusy(false);
    }
  }

  /** Takes a deleted item off the list, moving focus to its neighbor if its button had it. */
  function removeItem(item: Item, origin: Element | null) {
    const index = items.findIndex((i) => i.id === item.id);
    const neighbor = index === -1 ? undefined : (items[index + 1] ?? items[index - 1]);
    setRemoved((prev) => new Set(prev).add(item.id));
    setAnnouncement(`Deleted “${item.name}”.`);
    if (origin) {
      focusAfterRender(
        () => (neighbor && deleteButtons.current.get(neighbor.id)) || headingRef.current,
        origin,
      );
    }
  }

  async function onDelete(item: Item) {
    if (deleting.has(item.id)) return;
    if (!window.confirm(`Delete “${item.name}”? This cannot be undone.`)) return;
    // The button is disabled while the request runs, then removed.
    const origin = focusIn(deleteButtons.current.get(item.id));
    setDeleting((prev) => new Set(prev).add(item.id));
    setFailure(null);
    setAnnouncement("");
    try {
      await api.delete__Entity__(orgId, item.id);
      removeItem(item, origin);
    } catch (error) {
      // Already gone (another tab or member deleted it): what the user asked for is done.
      if (error instanceof ApiError && error.code === "NOT_FOUND") {
        removeItem(item, origin);
      } else {
        setFailure({ error });
        if (origin) focusAfterRender(() => deleteButtons.current.get(item.id), origin);
      }
    } finally {
      setDeleting((prev) => {
        const next = new Set(prev);
        next.delete(item.id);
        return next;
      });
    }
  }

  return (
    <section className="card" aria-labelledby="__path__-title">
      <h2 id="__path__-title" ref={headingRef} tabIndex={-1}>
        __Module__
      </h2>
      {can?.create && (
        <form className="inline-form" onSubmit={onCreate} noValidate>
          <label htmlFor={inputId}>Name</label>
          <div className="inline-form-row">
            <input
              id={inputId}
              value={name}
              // In UTF-16 units: room for MAX_NAME characters of any kind; onCreate checks the count.
              maxLength={MAX_NAME * 2}
              onChange={(e) => setName(e.target.value)}
              aria-invalid={nameError ? true : undefined}
              aria-describedby={nameError ? errorId : undefined}
              autoComplete="off"
            />
            <button type="submit" className="button button-primary" disabled={busy}>
              {busy ? "Creating…" : "Create"}
            </button>
          </div>
          {nameError && (
            <p id={errorId} className="field-error" role="alert">
              {nameError}
            </p>
          )}
        </form>
      )}
      <p className="visually-hidden" role="status" aria-live="polite">
        {announcement}
      </p>
      {failure && (
        <div ref={failureRef}>
          <ErrorState error={failure.error} onRetry={failure.retry} />
        </div>
      )}

      {first.loading && <LoadingState label="Loading __label__…" />}
      {first.error !== undefined && <ErrorState error={first.error} onRetry={retry} />}
      {first.data && items.length === 0 && (
        <EmptyState title="Nothing here yet">{can?.create && <p>Create the first one above.</p>}</EmptyState>
      )}
      {first.data && items.length > 0 && (
        <ul className="list">
          {items.map((item, index) => (
            <li key={item.id} className="list-item">
              <span id={`${rowId}-name-${index}`}>{item.name}</span>
              {can?.delete && (
                // Named "Delete <name>" through aria-labelledby: error reports copy aria-label, never text.
                <button
                  ref={(button) => {
                    if (!button) return;
                    deleteButtons.current.set(item.id, button);
                    return () => {
                      deleteButtons.current.delete(item.id);
                    };
                  }}
                  id={`${rowId}-delete-${index}`}
                  type="button"
                  className="button button-small"
                  aria-labelledby={`${rowId}-delete-${index} ${rowId}-name-${index}`}
                  disabled={deleting.has(item.id)}
                  onClick={() => void onDelete(item)}
                >
                  {deleting.has(item.id) ? "Deleting…" : "Delete"}
                </button>
              )}
            </li>
          ))}
        </ul>
      )}
      {first.data && cursor && (
        <button
          ref={loadMoreRef}
          type="button"
          className="button"
          onClick={() => void loadMore()}
          disabled={loadingMore}
        >
          {loadingMore ? "Loading…" : "Load more"}
        </button>
      )}
    </section>
  );
}
