"use client";

import { useCallback, useId, useState, type FormEvent } from "react";

import type { Schemas } from "@/lib/api/client";
import { useApi } from "@/lib/api/use-api";
import { useResource } from "@/lib/use-resource";
import { EmptyState, ErrorState, LoadingState } from "@/ui/state-views";

type Props = { orgId: string | null; canDelete: boolean };
type Item = Schemas["__Entity__"];

const MAX_NAME = 120;

/**
 * Generated by `pnpm new:module`: list, create, and delete __label__ in the
 * active tenant. Remounts per tenant, so no state from another tenant is shown.
 */
export function __Module__Panel(props: Props) {
  return <__Module__List key={props.orgId ?? "personal"} {...props} />;
}

function __Module__List({ orgId, canDelete }: Props) {
  const api = useApi();
  const inputId = useId();
  const errorId = useId();
  const fetchFirstPage = useCallback(() => api.list__Module__(orgId), [api, orgId]);
  const first = useResource(fetchFirstPage, `__path__:${orgId ?? "personal"}`);
  const [added, setAdded] = useState<Item[]>([]);
  const [more, setMore] = useState<Item[]>([]);
  const [moreCursor, setMoreCursor] = useState<string | null | undefined>(undefined);
  const [removed, setRemoved] = useState<ReadonlySet<string>>(new Set());
  const [loadingMore, setLoadingMore] = useState(false);
  const [name, setName] = useState("");
  const [nameError, setNameError] = useState<string | null>(null);
  // A failed create, delete, or load more; ErrorState presents it through presentError (FE-10).
  const [failure, setFailure] = useState<unknown>(undefined);
  const [busy, setBusy] = useState(false);

  const items = [...added, ...(first.data?.items ?? []), ...more].filter((i) => !removed.has(i.id));
  const cursor = moreCursor === undefined ? (first.data?.next_cursor ?? null) : moreCursor;

  async function loadMore() {
    if (!cursor) return;
    setLoadingMore(true);
    setFailure(undefined);
    try {
      const page = await api.list__Module__(orgId, cursor);
      setMore((prev) => [...prev, ...page.items]);
      setMoreCursor(page.next_cursor);
    } catch (error) {
      setFailure(error);
    } finally {
      setLoadingMore(false);
    }
  }

  function retry() {
    setAdded([]);
    setMore([]);
    setMoreCursor(undefined);
    setRemoved(new Set());
    setFailure(undefined);
    first.reload();
  }

  async function onCreate(event: FormEvent) {
    event.preventDefault();
    const trimmed = name.trim();
    if (!trimmed || trimmed.length > MAX_NAME) {
      setNameError(`Enter a name of 1 to ${MAX_NAME} characters.`);
      return;
    }
    setBusy(true);
    setNameError(null);
    setFailure(undefined);
    try {
      const created = await api.create__Entity__(orgId, trimmed);
      setAdded((prev) => [created, ...prev]);
      setName("");
    } catch (error) {
      setFailure(error);
    } finally {
      setBusy(false);
    }
  }

  async function onDelete(item: Item) {
    if (!window.confirm(`Delete “${item.name}”? This cannot be undone.`)) return;
    setFailure(undefined);
    try {
      await api.delete__Entity__(orgId, item.id);
      setRemoved((prev) => new Set(prev).add(item.id));
    } catch (error) {
      setFailure(error);
    }
  }

  return (
    <section className="card" aria-labelledby="__path__-title">
      <h2 id="__path__-title">__Module__</h2>
      <form className="inline-form" onSubmit={onCreate} noValidate>
        <label htmlFor={inputId}>Name</label>
        <div className="inline-form-row">
          <input
            id={inputId}
            value={name}
            maxLength={MAX_NAME}
            onChange={(e) => setName(e.target.value)}
            aria-invalid={nameError ? true : undefined}
            aria-describedby={nameError ? errorId : undefined}
            autoComplete="off"
          />
          <button type="submit" className="button button-primary" disabled={busy}>
            {busy ? "Creating…" : "Create"}
          </button>
        </div>
        {nameError && (
          <p id={errorId} className="field-error" role="alert">
            {nameError}
          </p>
        )}
      </form>
      {failure !== undefined && <ErrorState error={failure} />}

      {first.loading && <LoadingState label="Loading __label__…" />}
      {first.error !== undefined && <ErrorState error={first.error} onRetry={retry} />}
      {first.data && items.length === 0 && (
        <EmptyState title="Nothing here yet">
          <p>Create the first one above.</p>
        </EmptyState>
      )}
      {first.data && items.length > 0 && (
        <ul className="list">
          {items.map((item) => (
            <li key={item.id} className="list-item">
              <span>{item.name}</span>
              {canDelete && (
                <button
                  type="button"
                  className="button button-small"
                  onClick={() => void onDelete(item)}
                  aria-label={`Delete ${item.name}`}
                >
                  Delete
                </button>
              )}
            </li>
          ))}
        </ul>
      )}
      {first.data && cursor && (
        <button type="button" className="button" onClick={() => void loadMore()} disabled={loadingMore}>
          {loadingMore ? "Loading…" : "Load more"}
        </button>
      )}
    </section>
  );
}
