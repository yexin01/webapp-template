import { act, render, screen, waitFor, within } from "@testing-library/react";
import userEvent from "@testing-library/user-event";

import type { Schemas } from "@/lib/api/client";
import { ApiError } from "@/lib/api/errors";
import { CLERK_LOAD_BACKSTOP_MS } from "@/lib/use-resource";

import { __Module__Panel } from "./__path__-panel";

const api = {
  list__Module__: vi.fn<(orgId: string | null, cursor?: string | null) => Promise<Schemas["__Entity__Page"]>>(),
  create__Entity__: vi.fn<(orgId: string | null, name: string) => Promise<Schemas["__Entity__"]>>(),
  delete__Entity__: vi.fn<(orgId: string | null, id: string) => Promise<void>>(),
};

const auth = vi.hoisted(() => ({ isLoaded: true, userId: "user_a" }));
// What Clerk says about the active organization. The panel takes the tenant from it and nothing else:
// the role is there to be ignored, because the API's `can` decides what is offered.
const clerk = vi.hoisted(() => ({
  orgLoaded: true,
  organization: null as { id: string; name: string } | null,
  membership: null as { role: string } | null,
}));

vi.mock("@/lib/api/use-api", () => ({ useApi: () => api }));
vi.mock("next/navigation", () => ({ usePathname: () => "/dashboard" }));
vi.mock("@clerk/nextjs", () => ({
  useAuth: () => auth,
  useClerk: () => ({ status: "ready" }),
  useOrganization: () => ({
    isLoaded: clerk.orgLoaded,
    organization: clerk.organization,
    membership: clerk.membership,
  }),
}));

const item: Schemas["__Entity__"] = {
  id: "00000000-0000-4000-8000-000000000001",
  name: "First",
  organization_scoped: false,
  created_at: "2026-01-01T00:00:00Z",
};
const older: Schemas["__Entity__"] = { ...item, id: "00000000-0000-4000-8000-000000000002", name: "Older" };

const mayAll = { create: true, delete: true };

/** A page as the API answers it; `can` is its decision for the caller. */
function listing(
  items: Schemas["__Entity__"][],
  nextCursor: string | null = null,
  can: Schemas["__Entity__Capabilities"] = mayAll,
): Schemas["__Entity__Page"] {
  return { items, next_cursor: nextCursor, can };
}

/** The active organization is Acme (org_1) rather than the personal workspace. */
function inOrganization() {
  clerk.organization = { id: "org_1", name: "Acme" };
}

beforeEach(() => {
  auth.isLoaded = true;
  auth.userId = "user_a";
  clerk.orgLoaded = true;
  clerk.organization = null;
  clerk.membership = null;
  api.list__Module__.mockReset().mockResolvedValue(listing([]));
  api.create__Entity__.mockReset().mockResolvedValue(item);
  api.delete__Entity__.mockReset().mockResolvedValue(undefined);
});

afterEach(() => {
  vi.restoreAllMocks();
});

describe("__path__ panel", () => {
  it("shows the empty state, then creates an item", async () => {
    render(<__Module__Panel />);
    expect(await screen.findByText("Nothing here yet")).toBeInTheDocument();
    await userEvent.type(screen.getByLabelText("Name"), "First");
    await userEvent.click(screen.getByRole("button", { name: "Create" }));
    expect(api.create__Entity__).toHaveBeenCalledWith(null, "First");
    expect(await screen.findByText("First")).toBeInTheDocument();
    expect(screen.getByLabelText("Name")).toHaveValue("");
    expect(screen.getByText("Created “First”.")).toHaveAttribute("role", "status");
  });

  it("lists an item created here once, even when a later page returns it", async () => {
    api.list__Module__.mockResolvedValue(listing([older], "cursor-1"));
    render(<__Module__Panel />);
    await userEvent.type(await screen.findByLabelText("Name"), "First");
    await userEvent.click(screen.getByRole("button", { name: "Create" }));
    expect(await screen.findByText("First")).toBeInTheDocument();

    api.list__Module__.mockResolvedValueOnce(listing([item]));
    await userEvent.click(screen.getByRole("button", { name: "Load more" }));
    // Load more goes once the last page is in.
    await waitFor(() => expect(screen.queryByRole("button", { name: "Load more" })).toBeNull());
    expect(screen.getAllByRole("listitem")).toHaveLength(2);
  });

  it("counts characters as the server does: 120 emoji fit, 121 characters do not", async () => {
    render(<__Module__Panel />);
    const input = await screen.findByLabelText("Name");
    const fits = "\u{1F600}".repeat(120);
    await userEvent.click(input);
    await userEvent.paste(fits);
    expect(input).toHaveValue(fits);
    await userEvent.click(screen.getByRole("button", { name: "Create" }));
    expect(api.create__Entity__).toHaveBeenCalledWith(null, fits);
    await userEvent.click(input);
    await userEvent.paste("a".repeat(121));
    await userEvent.click(screen.getByRole("button", { name: "Create" }));
    expect(await screen.findByRole("alert")).toHaveTextContent("1 to 120 characters");
    expect(api.create__Entity__).toHaveBeenCalledOnce();
  });

  it("disables Delete while it runs, and removes an item already deleted elsewhere", async () => {
    api.list__Module__.mockResolvedValue(listing([item, older]));
    let finish: () => void = () => undefined;
    api.delete__Entity__
      .mockReturnValueOnce(new Promise<void>((resolve) => (finish = resolve)))
      .mockRejectedValueOnce(new ApiError(404, "NOT_FOUND", "Not found.", null));
    vi.spyOn(window, "confirm").mockReturnValue(true);
    inOrganization();
    render(<__Module__Panel />);
    const remove = await screen.findByRole("button", { name: "Delete First" });
    await userEvent.click(remove);
    expect(remove).toBeDisabled();
    await userEvent.click(remove);
    expect(api.delete__Entity__).toHaveBeenCalledOnce();
    await act(async () => finish());
    expect(screen.queryByText("First")).toBeNull();

    await userEvent.click(screen.getByRole("button", { name: "Delete Older" }));
    expect(await screen.findByText("Nothing here yet")).toBeInTheDocument();
    expect(screen.queryByRole("alert")).toBeNull();
  });

  it("keeps keyboard focus and announces each delete", async () => {
    api.list__Module__.mockResolvedValue(listing([item, older]));
    vi.spyOn(window, "confirm").mockReturnValue(true);
    inOrganization();
    render(<__Module__Panel />);
    (await screen.findByRole("button", { name: "Delete First" })).focus();
    await userEvent.keyboard("{Enter}");
    await waitFor(() => expect(screen.queryByText("First")).toBeNull());
    expect(screen.getByRole("button", { name: "Delete Older" })).toHaveFocus();
    expect(screen.getByText("Deleted “First”.")).toHaveAttribute("role", "status");
    await userEvent.keyboard("{Enter}");
    expect(await screen.findByText("Nothing here yet")).toBeInTheDocument();
    expect(screen.getByRole("heading", { name: "__Module__" })).toHaveFocus();
  });

  it("leaves focus where the user moved it while a delete or Load more ran", async () => {
    let finish: () => void = () => undefined;
    let answer: (page: Schemas["__Entity__Page"]) => void = () => undefined;
    api.list__Module__
      .mockResolvedValueOnce(listing([item, older], "cursor-1"))
      .mockReturnValueOnce(new Promise((resolve) => (answer = resolve)));
    api.delete__Entity__.mockReturnValueOnce(new Promise<void>((resolve) => (finish = resolve)));
    vi.spyOn(window, "confirm").mockReturnValue(true);
    inOrganization();
    render(<__Module__Panel />);
    const input = await screen.findByLabelText("Name");
    /** The user moves on to the name field and types while the request runs. */
    const typeAName = async () => {
      await userEvent.click(input);
      await userEvent.keyboard("Next");
      expect(input).toHaveFocus();
    };

    (await screen.findByRole("button", { name: "Delete First" })).focus();
    await userEvent.keyboard("{Enter}");
    await typeAName();
    await act(async () => finish());
    expect(screen.queryByText("First")).toBeNull();
    expect(input).toHaveFocus();

    screen.getByRole("button", { name: "Load more" }).focus();
    await userEvent.keyboard("{Enter}");
    await typeAName();
    const third = { ...item, id: "00000000-0000-4000-8000-000000000003", name: "Third" };
    await act(async () => answer(listing([third])));
    expect(screen.getByText("Third")).toBeInTheDocument();
    expect(input).toHaveFocus();
  });

  it("keeps keyboard focus when a failed first page is retried and when the last page loads", async () => {
    api.list__Module__
      .mockRejectedValueOnce(ApiError.network())
      .mockResolvedValueOnce(listing([item], "cursor-1"))
      .mockResolvedValueOnce(listing([older]));
    inOrganization();
    render(<__Module__Panel />);
    (await screen.findByRole("button", { name: "Try again" })).focus();
    await userEvent.keyboard("{Enter}");
    expect(await screen.findByText("First")).toBeInTheDocument();
    expect(screen.getByRole("heading", { name: "__Module__" })).toHaveFocus();

    screen.getByRole("button", { name: "Load more" }).focus();
    await userEvent.keyboard("{Enter}");
    expect(await screen.findByText("Older")).toBeInTheDocument();
    expect(screen.getByRole("button", { name: "Delete Older" })).toHaveFocus();
  });

  it("shows a name the server rejects next to the field", async () => {
    api.create__Entity__.mockRejectedValue(new ApiError(400, "INVALID_REQUEST", "Name must not contain NUL characters.", null));
    render(<__Module__Panel />);
    await userEvent.type(await screen.findByLabelText("Name"), "First");
    await userEvent.click(screen.getByRole("button", { name: "Create" }));
    expect(await screen.findByRole("alert")).toHaveTextContent("Name must not contain NUL characters.");
    expect(screen.getByLabelText("Name")).toHaveAttribute("aria-invalid", "true");
    expect(screen.getByLabelText("Name")).toHaveValue("First");
  });

  it("rejects an empty name without calling the API", async () => {
    render(<__Module__Panel />);
    await userEvent.click(await screen.findByRole("button", { name: "Create" }));
    expect(screen.getByRole("alert")).toHaveTextContent("1 to 120 characters");
    expect(screen.getByLabelText("Name")).toHaveAttribute("aria-invalid", "true");
    expect(api.create__Entity__).not.toHaveBeenCalled();
  });

  it("offers nothing to create until the list says the caller may", async () => {
    let answer: (page: Schemas["__Entity__Page"]) => void = () => undefined;
    api.list__Module__.mockReturnValueOnce(new Promise((resolve) => (answer = resolve)));
    render(<__Module__Panel />);
    expect(screen.getByText("Loading __label__…")).toBeInTheDocument();
    expect(screen.queryByLabelText("Name")).toBeNull();
    expect(screen.queryByRole("button", { name: "Create" })).toBeNull();

    await act(async () => answer(listing([item])));
    expect(screen.getByLabelText("Name")).toBeInTheDocument();
    expect(screen.getByRole("button", { name: "Create" })).toBeInTheDocument();
  });

  it.each([
    ["neither create nor delete", { create: false, delete: false }, { form: false, remove: false }],
    ["create but not delete", { create: true, delete: false }, { form: true, remove: false }],
    ["delete but not create", { create: false, delete: true }, { form: false, remove: true }],
    ["both", mayAll, { form: true, remove: true }],
  ])("shows what a caller who may %s is offered, and no more", async (_case, can, shown) => {
    api.list__Module__.mockResolvedValue(listing([item], null, can));
    render(<__Module__Panel />);
    expect(await screen.findByText("First")).toBeInTheDocument();
    expect(screen.queryByLabelText("Name") !== null).toBe(shown.form);
    expect(screen.queryByRole("button", { name: "Create" }) !== null).toBe(shown.form);
    expect(screen.queryByRole("button", { name: "Delete First" }) !== null).toBe(shown.remove);
  });

  it.each([
    ["an administrator the API does not let delete", "org:admin", { create: true, delete: false }, false],
    ["a member the API lets delete", "org:member", { create: true, delete: true }, true],
  ])("shows Delete for %s as the API says, whatever Clerk's role is", async (_case, role, can, shown) => {
    inOrganization();
    clerk.membership = { role };
    api.list__Module__.mockResolvedValue(listing([item], null, can));
    render(<__Module__Panel />);
    expect(await screen.findByText("First")).toBeInTheDocument();
    expect(screen.queryByRole("button", { name: "Delete First" }) !== null).toBe(shown);
  });

  it("suggests creating the first one only to a caller who may", async () => {
    api.list__Module__.mockResolvedValue(listing([], null, { create: false, delete: false }));
    const { unmount } = render(<__Module__Panel />);
    expect(await screen.findByText("Nothing here yet")).toBeInTheDocument();
    expect(screen.queryByText("Create the first one above.")).toBeNull();
    unmount();

    api.list__Module__.mockResolvedValue(listing([]));
    render(<__Module__Panel />);
    expect(await screen.findByText("Create the first one above.")).toBeInTheDocument();
  });

  it("lists nothing until the tenant is known, then only that tenant's items", async () => {
    // The session is there before the organization: a list for the personal workspace would be the wrong one.
    clerk.orgLoaded = false;
    const { rerender } = render(<__Module__Panel />);
    expect(screen.getByText("Loading __label__…")).toBeInTheDocument();
    expect(api.list__Module__).not.toHaveBeenCalled();

    clerk.orgLoaded = true;
    inOrganization();
    rerender(<__Module__Panel />);
    await waitFor(() => expect(api.list__Module__).toHaveBeenCalledOnce());
    expect(api.list__Module__).toHaveBeenCalledWith("org_1");
  });

  it("shows nothing of the previous organization's after a switch", async () => {
    api.list__Module__.mockImplementation(async (orgId: string | null) =>
      listing([orgId === "org_1" ? item : older]),
    );
    inOrganization();
    const { rerender } = render(<__Module__Panel />);
    expect(await screen.findByText("First")).toBeInTheDocument();
    await userEvent.type(screen.getByLabelText("Name"), "half typed");

    clerk.organization = { id: "org_2", name: "Globex" };
    rerender(<__Module__Panel />);
    expect(await screen.findByText("Older")).toBeInTheDocument();
    expect(screen.queryByText("First")).toBeNull();
    expect(screen.getByLabelText("Name")).toHaveValue("");
    expect(api.list__Module__).toHaveBeenLastCalledWith("org_2");
  });

  it("offers a reload instead of loading forever when Clerk never loads (§16.4)", () => {
    vi.useFakeTimers();
    try {
      auth.isLoaded = false;
      clerk.orgLoaded = false;
      const reloadPage = vi.fn();
      vi.spyOn(window, "location", "get").mockReturnValue({ ...window.location, reload: reloadPage });
      render(<__Module__Panel />);
      expect(screen.getByText("Loading __label__…")).toBeInTheDocument();

      act(() => vi.advanceTimersByTime(CLERK_LOAD_BACKSTOP_MS));
      expect(screen.getByRole("alert")).toHaveTextContent("Sign-in unavailable");
      act(() => screen.getByRole("button", { name: "Try again" }).click());
      expect(reloadPage).toHaveBeenCalledOnce();
      expect(api.list__Module__).not.toHaveBeenCalled();
    } finally {
      vi.useRealTimers();
    }
  });

  it("loads the next page from the cursor", async () => {
    api.list__Module__
      .mockResolvedValueOnce(listing([item], "cursor-1"))
      .mockResolvedValueOnce(listing([older]));
    inOrganization();
    render(<__Module__Panel />);
    await userEvent.click(await screen.findByRole("button", { name: "Load more" }));
    expect(api.list__Module__).toHaveBeenLastCalledWith("org_1", "cursor-1");
    expect(await screen.findByText("Older")).toBeInTheDocument();
    expect(screen.getByText("First")).toBeInTheDocument();
    expect(screen.queryByRole("button", { name: "Load more" })).toBeNull();
  });

  it("starts over from the first page when the server rejects the Load more cursor", async () => {
    api.list__Module__
      .mockResolvedValueOnce(listing([item], "cursor-1"))
      .mockRejectedValueOnce(new ApiError(400, "INVALID_REQUEST", "The pagination cursor is invalid.", null))
      .mockResolvedValueOnce(listing([item, older]));
    inOrganization();
    render(<__Module__Panel />);
    await userEvent.click(await screen.findByRole("button", { name: "Load more" }));
    const alert = await screen.findByRole("alert");
    expect(alert).toHaveTextContent("Request not accepted");
    // Sending the same cursor again would fail the same way, so Load more is gone until the list starts over.
    expect(screen.queryByRole("button", { name: "Load more" })).toBeNull();
    expect(within(alert).getByRole("button", { name: "Try again" })).toHaveFocus();
    await userEvent.click(within(alert).getByRole("button", { name: "Try again" }));
    expect(await screen.findByText("Older")).toBeInTheDocument();
    expect(api.list__Module__).toHaveBeenLastCalledWith("org_1");
    expect(screen.queryByRole("alert")).toBeNull();
  });

  it("deletes only after confirmation", async () => {
    api.list__Module__.mockResolvedValue(listing([item]));
    const confirm = vi.spyOn(window, "confirm").mockReturnValueOnce(false).mockReturnValueOnce(true);
    inOrganization();
    render(<__Module__Panel />);
    const remove = await screen.findByRole("button", { name: "Delete First" });
    // Error reports copy element attributes into click breadcrumbs, so the name stays out of them.
    expect([...remove.attributes].map((attribute) => attribute.value).join(" ")).not.toContain("First");
    await userEvent.click(remove);
    expect(confirm).toHaveBeenCalledWith(expect.stringContaining("First"));
    expect(api.delete__Entity__).not.toHaveBeenCalled();
    await userEvent.click(remove);
    expect(api.delete__Entity__).toHaveBeenCalledWith("org_1", item.id);
    expect(await screen.findByText("Nothing here yet")).toBeInTheDocument();
  });

  it("shows nothing of the previous user's after a Clerk account switch", async () => {
    api.list__Module__.mockResolvedValueOnce(listing([item]));
    const { rerender } = render(<__Module__Panel />);
    expect(await screen.findByText("First")).toBeInTheDocument();
    await userEvent.type(screen.getByLabelText("Name"), "Created by A");
    api.create__Entity__.mockResolvedValueOnce({ ...item, id: "00000000-0000-4000-8000-000000000003", name: "Created by A" });
    await userEvent.click(screen.getByRole("button", { name: "Create" }));
    expect(await screen.findByText("Created by A")).toBeInTheDocument();

    auth.userId = "user_b";
    rerender(<__Module__Panel />);
    expect(await screen.findByText("Nothing here yet")).toBeInTheDocument();
    expect(screen.queryByText("First")).toBeNull();
    expect(screen.queryByText("Created by A")).toBeNull();
    expect(api.list__Module__).toHaveBeenCalledTimes(2);
  });

  it("presents failed actions with the shared error copy, not as a name error", async () => {
    api.list__Module__
      .mockResolvedValueOnce(listing([item], "cursor-1"))
      .mockRejectedValueOnce(ApiError.network());
    api.delete__Entity__.mockRejectedValue(new ApiError(403, "FORBIDDEN", "Only admins can delete.", null));
    vi.spyOn(window, "confirm").mockReturnValue(true);
    inOrganization();
    render(<__Module__Panel />);
    await userEvent.click(await screen.findByRole("button", { name: "Load more" }));
    expect(await screen.findByText("Temporarily unavailable")).toBeInTheDocument();
    await userEvent.click(screen.getByRole("button", { name: "Delete First" }));
    expect(await screen.findByText("Not allowed")).toBeInTheDocument();
    expect(screen.getByRole("alert")).toHaveTextContent("Only admins can delete.");
    expect(screen.getByText("First")).toBeInTheDocument();
    expect(screen.getByLabelText("Name")).not.toHaveAttribute("aria-invalid");
  });
});
