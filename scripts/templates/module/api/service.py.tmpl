"""__Module__ use cases."""

from __future__ import annotations

from dataclasses import replace
from uuid import UUID

from app.kernel.authorization import authorize, is_allowed
from app.kernel.errors import DomainError, ForbiddenError, NotFoundError
from app.kernel.pagination import PageCursor, bounded_limit
from app.kernel.ports import AuditEntry, Transactions, Tx
from app.kernel.tenancy import ContextKind, Role, TenantContext
from app.modules.__module__.domain import (
    __ENTITY___CREATE,
    __ENTITY___DELETE,
    __ENTITY___READ,
    Capabilities,
    __Entity__,
    __Entity__Created,
    clean_name,
)
from app.modules.__module__.ports import __Module__Repository


class __Module__Service:
    def __init__(self, tx: Transactions[__Module__Repository]) -> None:
        self._tx = tx

    def list(self, ctx: TenantContext, limit: int, after: PageCursor | None) -> list[__Entity__]:
        authorize(ctx, __ENTITY___READ)
        with self._tx.as_tenant(ctx) as t:
            return t.repo.list(ctx, bounded_limit(limit), after)

    def capabilities(self, ctx: TenantContext) -> Capabilities:
        """The UI shows actions from this, never from a role: one flag per action a route enforces."""
        return Capabilities(create=is_allowed(ctx, __ENTITY___CREATE), delete=is_allowed(ctx, __ENTITY___DELETE))

    def create(self, ctx: TenantContext, name: str) -> __Entity__:
        authorize(ctx, __ENTITY___CREATE)
        clean = clean_name(name)
        with self._tx.as_tenant(ctx) as t:
            # A removal since the context was resolved is a 404, not an RLS error (TEN-05, TEN-07).
            if ctx.kind is ContextKind.ORGANIZATION and _my_locked_role(t, ctx) is None:
                raise NotFoundError()
            item = t.repo.create(ctx, clean)
            t.record(__Entity__Created(__entity___id=item.id, user_id=ctx.user_id, org_id=ctx.org_id, context=ctx.kind))
        return item

    def delete(self, ctx: TenantContext, item_id: UUID, request_id: str | None) -> None:
        with self._tx.as_tenant(ctx) as t:
            refusal = _delete_refusal(t, ctx)
            if refusal is None:
                if not t.repo.delete(ctx, item_id):
                    raise NotFoundError()
                if ctx.kind is ContextKind.ORGANIZATION:
                    t.audit(_audit(ctx, item_id, "succeeded", request_id))
            else:
                # The block ends normally so the denial's audit entry commits (ADM-01, NT-07).
                t.audit(_audit(ctx, item_id, "denied", request_id))
        if refusal is not None:
            raise refusal


def _delete_refusal(t: Tx[__Module__Repository], ctx: TenantContext) -> DomainError | None:
    """Why the caller may not delete, decided inside the writing transaction."""
    if not is_allowed(ctx, __ENTITY___DELETE):
        return ForbiddenError()
    if ctx.kind is not ContextKind.ORGANIZATION:
        return None
    # Re-read under a row lock, so a concurrent downgrade cannot commit first (TEN-07, NT-06).
    role = _my_locked_role(t, ctx)
    if role is None:
        return NotFoundError()  # removed since the context was resolved: a non-member (TEN-05)
    return None if is_allowed(replace(ctx, role=role), __ENTITY___DELETE) else ForbiddenError()


def _my_locked_role(t: Tx[__Module__Repository], ctx: TenantContext) -> Role | None:
    """The caller's current role in the context organization, locked until the transaction ends."""
    return None if ctx.org_id is None else t.lock_my_role(ctx.org_id)


def _audit(ctx: TenantContext, item_id: UUID, outcome: str, request_id: str | None) -> AuditEntry:
    return AuditEntry(ctx.user_id, ctx.org_id, __ENTITY___DELETE.name, "__entity__", str(item_id), outcome, request_id)
