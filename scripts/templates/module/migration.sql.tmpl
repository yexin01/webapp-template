-- __Module__: tenant-scoped resource generated by `pnpm new:module`.
-- Same tenancy model as app.projects: a row belongs to exactly one user or one
-- organization. RLS is forced, and the API role sees only its own tenant's rows.

CREATE TABLE app.__module__ (
  id            uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  org_id        uuid REFERENCES app.organizations (id) ON DELETE RESTRICT,
  owner_user_id uuid REFERENCES app.users (id) ON DELETE RESTRICT,
  created_by    uuid NOT NULL REFERENCES app.users (id) ON DELETE RESTRICT,
  name          text NOT NULL CHECK (length(btrim(name)) BETWEEN 1 AND 120),
  created_at    timestamptz NOT NULL DEFAULT now(),
  CONSTRAINT __module___single_tenant CHECK ((org_id IS NULL) <> (owner_user_id IS NULL))
);
CREATE INDEX __module___org_page_idx ON app.__module__ (org_id, created_at DESC, id DESC) WHERE org_id IS NOT NULL;
CREATE INDEX __module___owner_page_idx ON app.__module__ (owner_user_id, created_at DESC, id DESC)
  WHERE owner_user_id IS NOT NULL;

ALTER TABLE app.__module__ ENABLE ROW LEVEL SECURITY;
ALTER TABLE app.__module__ FORCE ROW LEVEL SECURITY;

GRANT SELECT, INSERT, DELETE ON app.__module__ TO app_api;
CREATE POLICY __module___api_access ON app.__module__ FOR ALL TO app_api
  USING (
    (org_id IS NULL AND app.ctx_org_id() IS NULL AND owner_user_id = app.ctx_user_id())
    OR (org_id IS NOT NULL AND org_id = app.ctx_org_id() AND EXISTS (
          SELECT 1 FROM app.organization_memberships m
          WHERE m.org_id = __module__.org_id AND m.user_id = app.ctx_user_id()))
  )
  WITH CHECK (
    created_by = app.ctx_user_id() AND (
      (org_id IS NULL AND app.ctx_org_id() IS NULL AND owner_user_id = app.ctx_user_id())
      OR (org_id IS NOT NULL AND org_id = app.ctx_org_id() AND EXISTS (
            SELECT 1 FROM app.organization_memberships m
            WHERE m.org_id = __module__.org_id AND m.user_id = app.ctx_user_id())))
  );

GRANT SELECT ON app.__module__ TO app_worker;
CREATE POLICY __module___worker_select ON app.__module__ FOR SELECT TO app_worker USING (true);
