#!/bin/sh
# Pre-commit secret scan (SEC-05, ENV-06): refuses a commit whose staged
# changes contain a secret, using the same rules as CI (.gitleaks.toml).
#
# Opt in once per clone:  pnpm hooks:install
# (sets git's core.hooksPath to scripts/git-hooks)
set -eu

# Hooks run from the top of the working tree; be explicit for manual runs.
cd "$(git rev-parse --show-toplevel)"

if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<'MSG'
pre-commit: gitleaks is not installed, so staged changes cannot be scanned for secrets.
  macOS:  brew install gitleaks
  Other:  https://github.com/gitleaks/gitleaks#installing
Then commit again. To stop using this hook: git config --unset core.hooksPath
MSG
  exit 1
fi

# gitleaks 8.19 replaced `protect --staged` with `git --staged`.
if gitleaks git --help >/dev/null 2>&1; then
  set -- git --staged
else
  set -- protect --staged
fi

if ! gitleaks "$@" --redact --no-banner --config .gitleaks.toml; then
  cat >&2 <<'MSG'
pre-commit: gitleaks found a possible secret in the staged changes (value redacted above).
  Remove it from the change and rotate it if it is real (SEC-03).
  A reviewed false positive goes in .gitleaksignore with a justification.
MSG
  exit 1
fi
