{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "apps/web" },
    "api": {
      "root": "apps/api",
      "entrypoint": "index.py",
      "functions": {
        "index.py": { "excludeFiles": "{tests/**,.venv/**,.pytest_cache/**,.mypy_cache/**,.ruff_cache/**}" }
      }
    }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [
    { "path": "/api/v1/jobs/drain-outbox", "schedule": "15 2 * * *" },
    { "path": "/api/v1/jobs/prune-expired", "schedule": "0 5 * * *" },
    { "path": "/api/v1/jobs/reconcile-billing", "schedule": "0 4 * * *" },
    { "path": "/api/v1/jobs/reconcile-memberships", "schedule": "30 3 * * *" }
  ]
}
