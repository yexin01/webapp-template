# =============================================================================
# Environment configuration. Copy to `.env` (git-ignored) and edit:
#
#   cp .env.example .env          (`pnpm init-template` does this for you)
#
# One root `.env` serves both apps: the Python API (apps/api) and the Next.js web
# app (apps/web). Values here are SAFE PLACEHOLDERS ONLY. Use test/sandbox keys for
# local development; live keys are rejected unless APP_ENV=production.
# Only this file is read: not .env.local, .env.development*, .env.production*, .env.test*,
# or apps/web/.env* (the web build refuses them, naming the files). Restart `pnpm dev`
# after editing it (neither server reloads it). To pull values from Vercel, run
# `vercel env pull .env` at the repository root.
#
# How this file is organised, top to bottom:
#   1. Works with no accounts   The shipped values build, test and check the API. Edit nothing.
#   2. Sandbox accounts         Paste your provider keys. Clerk first: `pnpm dev` needs its two keys.
#   3. Deployment and CI        Set in Vercel and GitHub. Listed here so every name is in one place.
#   4. Advanced tuning          Every value is the code default. Delete a line to follow future defaults.
# Steps: docs/setup.md. Per provider: docs/integrations.md. Which Vercel scope, which service and which
# redeploy each variable needs: docs/deployment.md.
#
# The tag line (`# >`) above each variable says where it applies:
#   apps=web|api|both|cli   web = the Next.js app, api = the Python API, cli = `pnpm db:*` commands only
#   kind=public             inlined into the browser bundle: never put a secret here
#   kind=secret             server-only secret: store it as a secret variable on Vercel
#   kind=config             server-only, not a secret
#   baked                   the web app fixes the value when it is built, so a change needs a new build
#                           (on Vercel every variable change needs a redeploy, which rebuilds)
#   need=always             the apps do not start without it (a working value is shipped below)
#   need=deployed           required when APP_ENV is preview or production; local and test default it
#   need=mode               required only when the matching *_MODE enables the integration
#   need=optional           has a default: leave it empty or unset to use it
#   scopes=all              every environment (local, test, preview, production), each with its own value
#   scopes=preview+production | production   set on Vercel in those scopes only
#                           (the Vercel "Development" scope is not used by this template)
#   scopes=not-on-vercel    local shell, CI or GitHub Environment only
#   scopes=build            the Vercel (or CI) build environment of the web project
#
# Integration modes (spec §5.2):
#   mock     deterministic in-process fake, no network (default for tests)
#   sandbox  provider test mode / non-production project (use for local dev)
#   live     production credentials: only valid when APP_ENV=production
#   disabled off: no provider is called (analytics, error reporting, and the LLM check)
#
# Set by the platform, read and never written (do not put them in this file):
#   VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_BRANCH_URL, VERCEL_GIT_COMMIT_SHA.
# Derived by the web build, not settings (a value set by hand is overridden):
#   NEXT_PUBLIC_APP_ENV, NEXT_PUBLIC_ANALYTICS_ENABLED, NEXT_PUBLIC_ERROR_REPORTING_ENABLED,
#   NEXT_PUBLIC_STRIPE_CUSTOM_DOMAIN, NEXT_PUBLIC_CLERK_AUTHORIZED_PARTIES.
# =============================================================================


# =============================================================================
# 1. WORKS WITH NO ACCOUNTS
# =============================================================================

# --- Application ------------------------------------------------------------
# local | test | preview | production. On Vercel leave it unset: it is taken from VERCEL_ENV
# (production, preview; development is local), and a value that contradicts it is refused.
# Set `preview` on the Production scope only for a staging project. Never import this local
# file into a Vercel project (APP_ENV=local is refused there). Preview and production
# deployments must also set the four *_MODE variables below explicitly.
# > apps=both kind=config baked need=optional scopes=all
APP_ENV=local
# Public URL of the web app (scheme, host, optional port; no path): the API's CORS origin, the
# base of Stripe redirect URLs, and the default of CLERK_AUTHORIZED_PARTIES. Required when
# APP_ENV is preview or production (https in production); local and test default to this value.
# The web build reads it too: build again after changing it.
# > apps=both kind=config baked need=deployed scopes=preview+production
APP_BASE_URL=http://localhost:3000
# Where the web app forwards /api/v1/* (read at web build time). `pnpm dev` and the tests use this
# default. On Vercel with Services the platform routes /api/v1/* to the API first: leave it unset.
# Must use https when APP_ENV=production, unless it is this machine (localhost, 127.x.x.x, [::1]).
# > apps=web kind=config baked need=optional scopes=not-on-vercel
API_ORIGIN=http://127.0.0.1:8000
# Comma-separated origins allowed in the session token's `azp` claim, as a browser sends them
# (scheme, host, optional port; no path). Empty: the origin of APP_BASE_URL, which must be listed
# here when this is set. On a Vercel preview deployment (APP_ENV=preview and VERCEL_ENV=preview)
# the deployment's own URL and its branch URL are trusted in addition; production never adds any.
# The web proxy applies the same list, read when the web app is built: build again after changing it.
# A page opened at an origin not listed here loops between /sign-in and the page.
# > apps=both kind=config baked need=optional scopes=all
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# --- Database (PostgreSQL / Supabase) ----------------------------------------
# The local default matches docker-compose.yml (local-only credentials; `pnpm db:up`).
# Percent-encode special characters in a password: startup refuses a URL that does not parse.
# Hosted Supabase (a NON-production project; steps: docs/setup.md#supabase-optional-hosted-database):
#   - runtime: Connect > Transaction pooler, port 6543, user app_login.<project-ref> (created by
#     `pnpm db:api-login`), never the schema owner `postgres`;
#   - migrations: MIGRATION_DATABASE_URL below, the Session pooler (port 5432), which also works
#     from IPv4-only networks. The direct connection (db.<project-ref>.supabase.co) is IPv6-only
#     unless the project has the IPv4 add-on;
#   - do not copy driver-only suffixes (?pgbouncer=true, ?workaround=..., connection_limit=...):
#     libpq rejects them.
# In preview and production this must be the app_login role: the API refuses a login role that is
# a superuser, has BYPASSRLS, or owns the app tables. Connections to a non-local host use TLS
# (sslmode=require, which does not verify the certificate) unless the URL sets sslmode.
# > apps=api kind=secret need=always scopes=all
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/app
# The schema owner's connection, for `pnpm db:migrate`, `db:seed`, `db:reset` and `db:api-login`.
# Empty: DATABASE_URL is used. Never set it where the API runs: not in the Vercel project (the
# GitHub "Database migrate" workflow reads it from a GitHub Environment secret).
# > apps=cli kind=secret need=optional scopes=not-on-vercel
MIGRATION_DATABASE_URL=

# --- Integration modes ---------------------------------------------------------
# Each integration starts mock or disabled, so nothing external is called. Switch one to
# `sandbox` when you add its account (section 2). Preview and production must set all four.
# Allowed per environment: local and preview: BILLING_MODE mock|sandbox; LLM_MODE
# disabled|mock|sandbox; the two telemetry modes disabled|sandbox. Production: BILLING_MODE live;
# the other three disabled|live.
# mock | sandbox | live
# > apps=api kind=config need=deployed scopes=all
BILLING_MODE=mock
# disabled | mock | sandbox | live. `disabled` calls no provider and needs no key (the check
# answers "not configured").
# > apps=api kind=config need=deployed scopes=all
LLM_MODE=mock
# disabled | sandbox | live
# > apps=both kind=config baked need=deployed scopes=all
ANALYTICS_MODE=disabled
# disabled | sandbox | live
# > apps=both kind=config baked need=deployed scopes=all
ERROR_REPORTING_MODE=disabled


# =============================================================================
# 2. SANDBOX ACCOUNTS
# =============================================================================

# --- Clerk (authentication + organizations): START HERE for `pnpm dev` ---------
# These two ship as a well-formed but fake pair that means "Clerk is not configured": the build,
# the tests and `pnpm check:setup` work with them, and `pnpm dev` stops until you paste the keys of
# your Clerk DEVELOPMENT instance (Dashboard > API keys). The same instance must have Organizations
# enabled with Membership optional (docs/setup.md#clerk); Clerk's newer default, Membership required,
# removes the personal workspace. Production uses the production instance's pk_live_ / sk_live_ keys,
# only in the Production scope.
# The API also accepts the name CLERK_PUBLISHABLE_KEY for the publishable key.
# > apps=both kind=public baked need=always scopes=all
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsubm90LWNvbmZpZ3VyZWQteWV0LmludmFsaWQk
# The web app reads it in its proxy (and requires it when built on Vercel); the API reads it to
# list a user's organization memberships.
# > apps=both kind=secret need=always scopes=all
CLERK_SECRET_KEY=sk_test_clerk_not_configured_yet
# PEM public key of the instance for networkless token verification. Empty: keys are fetched from
# the instance's JWKS endpoint. The web app only checks that a value is a PEM and uses nothing else
# from it. A key of another instance fails every token.
# > apps=api kind=config need=optional scopes=all
CLERK_JWT_KEY=
# Signing secret of the Clerk webhook endpoint of THIS environment (whsec_...). Enables immediate
# membership revocation; without it, memberships are re-verified once older than
# MEMBERSHIP_MAX_STALENESS_SECONDS.
# > apps=api kind=secret need=optional scopes=preview+production
CLERK_WEBHOOK_SIGNING_SECRET=
# true | false. Sessions someone else started as a user (Clerk dashboard impersonation, actor tokens,
# agent tasks; the token has an `act` claim) get 403 unless this is true. When true, each audit entry
# written during one names the actor (app.audit_log.impersonator_clerk_id) and the logs record it.
# > apps=api kind=config need=optional scopes=all
CLERK_ALLOW_IMPERSONATION=false
# For tests and proofs only: the Clerk Backend API base URL (default https://api.clerk.com).
# CLERK_API_URL=https://api.clerk.com

# --- Stripe (billing) ----------------------------------------------------------
# Test-mode secret key (sk_test_...) or restricted key (rk_test_...). `pnpm setup:stripe` needs an
# unrestricted sk_test_ key. Production: sk_live_ or rk_live_.
# > apps=api kind=secret need=mode scopes=preview+production
STRIPE_SECRET_KEY=
# Signing secret of /api/v1/webhooks/stripe in THIS environment (whsec_...). `pnpm dev` and
# `pnpm check:setup` get it from the Stripe CLI themselves when BILLING_MODE=sandbox, the key is an
# sk_test_ key and the CLI is installed; every other command (`pnpm billing:reconcile`) reads it here:
# `stripe listen --print-secret`. A deployed environment uses the secret of its own endpoint.
# > apps=api kind=secret need=mode scopes=preview+production
STRIPE_WEBHOOK_SECRET=
# Recurring prices of the Pro plan (price_...): `pnpm setup:stripe` prints them. Only these two
# prices are purchasable. Sandbox and live prices have different IDs.
# > apps=api kind=config need=mode scopes=preview+production
STRIPE_PRICE_PRO_MONTHLY=
# > apps=api kind=config need=mode scopes=preview+production
STRIPE_PRICE_PRO_YEARLY=
# Comma-separated prices you no longer sell that still grant Pro to existing subscribers. When you
# change a price above, add the old one here.
# > apps=api kind=config need=optional scopes=preview+production
STRIPE_PRICE_PRO_MONTHLY_RETAINED=
# > apps=api kind=config need=optional scopes=preview+production
STRIPE_PRICE_PRO_YEARLY_RETAINED=
# Your Stripe custom domain for Checkout and the Customer Portal, e.g. payments.example.com.
# Live mode only. Set it and deploy BEFORE the domain goes live in Stripe: Stripe switches to it once
# its DNS verifies.
# > apps=both kind=config baked need=optional scopes=production
STRIPE_CUSTOM_DOMAIN=
# true: the scheduled reconcile-billing job applies Stripe's state when it finds a divergence.
# false (default): it only reports.
# > apps=api kind=config need=optional scopes=all
BILLING_RECONCILE_APPLY=false

# --- LLM provider (connectivity check only) -----------------------------------
# anthropic | openai
# > apps=api kind=config need=mode scopes=all
LLM_PROVIDER=anthropic
# Provider API key. Set a spending limit at the provider.
# > apps=api kind=secret need=mode scopes=all
LLM_API_KEY=
# Model ID to verify, as named by the provider.
# > apps=api kind=config need=mode scopes=all
LLM_MODEL=

# --- PostHog (product analytics) -----------------------------------------------
# Project token (phc_..., Project settings) of a NON-production project, never a personal (phx_) or
# secret (phs_) key: it ships in every browser bundle and is refused when it is not a project token.
# PostHog's Next.js guide names this variable NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN; this template reads
# NEXT_PUBLIC_POSTHOG_KEY. The API also accepts the name POSTHOG_PROJECT_API_KEY.
# > apps=both kind=public baked need=mode scopes=all
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com or https://eu.i.posthog.com, or your managed proxy
# (docs/integrations.md#posthog). The API also accepts the name POSTHOG_HOST; set it to the regional
# ingestion host when the browser uses a proxy, so the API keeps sending directly.
# > apps=both kind=public baked need=optional scopes=all
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (error monitoring) -------------------------------------------------
# DSN of the API project. A DSN identifies a project and is not a secret by Sentry's definition;
# the API keeps it out of logs.
# > apps=api kind=config need=mode scopes=all
SENTRY_DSN=
# DSN of the web project. Sentry's Vercel integration sets this name, and not SENTRY_DSN.
# > apps=web kind=public baked need=mode scopes=all
NEXT_PUBLIC_SENTRY_DSN=
# 0.0 - 1.0. At 0 the API sends no traces, not even for a request whose caller sent a sampled
# trace; its error events still carry the caller's trace ID. Above 0 the API samples each request a
# page makes at this rate: the browser sends no sampling decision and records no spans.
# > apps=both kind=config need=optional scopes=all
SENTRY_TRACES_SAMPLE_RATE=0
# Release that API error events are tagged with. When unset: VERCEL_GIT_COMMIT_SHA on Vercel,
# otherwise sentry-sdk's default (the git commit).
# > apps=api kind=config need=optional scopes=all
SENTRY_RELEASE=


# =============================================================================
# 3. DEPLOYMENT AND CI (set in Vercel and GitHub; see docs/deployment.md)
# =============================================================================

# --- Diagnostics (/integrations page) ------------------------------------------
# true | false. Empty = enabled everywhere except production. The page runs authenticated checks
# against every configured service.
# > apps=api kind=config need=optional scopes=preview+production
DIAGNOSTICS_ENABLED=
# Comma-separated Clerk user IDs (user_...) allowed to use diagnostics. Empty: any signed-in user
# when APP_ENV=local; nobody elsewhere. User IDs differ per Clerk instance: list the ones of the
# instance each environment uses.
# > apps=api kind=config need=optional scopes=preview+production
DIAGNOSTICS_OPERATOR_IDS=

# --- Scheduled jobs ------------------------------------------------------------
# Bearer secret that Vercel Cron sends to /api/v1/jobs/<name> (at least 32 characters, e.g.
# `openssl rand -hex 32`). Vercel Cron calls production deployments only: set it in the Production
# scope. Empty: the job endpoint is off; run jobs with `uv run python -m app.cli job <name>`.
# > apps=api kind=secret need=optional scopes=production
CRON_SECRET=

# --- Sentry source maps (web build only) ---------------------------------------
# These three are read by `next build` from the build environment of the web project (the Vercel
# project, or Sentry's Vercel integration, which sets all three), never from this file. Without
# SENTRY_AUTH_TOKEN no source maps are uploaded. With it, `next build` fails unless SENTRY_PROJECT is
# set, and SENTRY_ORG too unless the token is an organization token (sntrys_...). A CI build is
# never deployed, so its maps would not match the bundle users run.
# > apps=web kind=secret need=optional scopes=build
SENTRY_AUTH_TOKEN=
# Slug of the web Sentry project.
# > apps=web kind=config need=optional scopes=build
SENTRY_PROJECT=
# Sentry organization slug.
# > apps=web kind=config need=optional scopes=build
SENTRY_ORG=

# --- End-to-end tests (sandbox only; never real user accounts) ---------------
# The sandbox suite runs with `E2E_SANDBOX=1 pnpm test:e2e` (or `pnpm verify:sandbox`). The switch is read
# from the command line only, never from this file. The suite uses the Clerk development keys above (a
# production key is refused) and creates its test user in that instance on the first run: no password.
# A Clerk test address (it must contain +clerk_test); this is the default.
# E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com
# Database the account-free end-to-end API server uses. Unset: a database name nothing creates, so a
# test that starts using the database fails instead of writing to your development database.
# E2E_DATABASE_URL=


# =============================================================================
# 4. ADVANCED TUNING (apps=api kind=config need=optional scopes=all, unless noted)
# Every value below is the code default. Leave them: delete a line to follow a future default.
# A value outside its range, or a combination the thread budget refuses, stops startup and names
# the variable. The pools and the thread budget: docs/operations.md#connection-pools.
# =============================================================================

# DEBUG | INFO | WARNING | ERROR | CRITICAL, in any case
LOG_LEVEL=INFO
# Maximum JSON request body in bytes, 1024 to 4000000 (spec §15.3).
MAX_REQUEST_BODY_BYTES=1000000
# POST, PUT, PATCH and DELETE requests per signed-in user per minute, 1 to 600, on the routes that have no
# limit of their own: projects and the modules `pnpm new:module` generates. Every attempt counts, refused or
# not; past the limit the answer is 429 with Retry-After. Reads, checkout, the portal, the billing re-read, the
# LLM check, diagnostics and the webhooks are not counted here.
WRITES_PER_USER_PER_MINUTE=60

# Per-process connection pools: request work (app_api) and system work (app_worker: webhooks, jobs,
# rate limits, readiness, event dispatch after the response). Request pool 1 to 30, worker pool 2 to 10
# (billing synchronization uses all but one), both together at most 30.
DATABASE_POOL_MAX_SIZE=5
DATABASE_WORKER_POOL_MAX_SIZE=3
# Also the longest a request waits for its turn at the database before it gets a 503, and the
# longest event dispatch after a response waits for a free slot (past that, drain-outbox delivers
# the events). Above 0, up to 30.
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Per-statement timeout in milliseconds, 100 to 60000.
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Clerk membership reads in flight per instance (3 to 16). Each holds a server thread until Clerk
# answers; past the limit a request that needs a read gets 503 at once, and a membership webhook
# gets 503, so Clerk retries it.
CLERK_MAX_CONCURRENT_READS=8
# Approved bound: 300 s (DEC-009, ADR-0002). Lower values are allowed (0 to 300); higher ones are rejected.
MEMBERSHIP_MAX_STALENESS_SECONDS=300
# Users re-verified per run of the reconcile-memberships job, 1 to 1000.
MEMBERSHIP_RECONCILE_BATCH_SIZE=50

# Checkout sessions per user per hour, 1 to 1000.
CHECKOUTS_PER_USER_PER_HOUR=10
# Customer-portal sessions per user per hour, 1 to 1000. Each is a Stripe API call, and Stripe
# rate-limits the whole account.
PORTAL_SESSIONS_PER_USER_PER_HOUR=20
# Re-reads from Stripe per user per hour, 1 to 1000. The billing page asks for one after checkout and
# after the Customer Portal, in case the webhook is late.
BILLING_SYNCS_PER_USER_PER_HOUR=30
# Checkout, portal and re-read requests calling Stripe at once per API instance, 1 to 16. Each holds a
# server thread until Stripe answers; past the bound, checkout and the portal answer 503 at once.
BILLING_MAX_CONCURRENT_STRIPE_CALLS=4
# Customers checked per run of the reconcile-billing job (one Stripe call each), least recently
# checked first, 1 to 2000. Keep a run well inside the platform's function duration limit.
BILLING_RECONCILE_BATCH_SIZE=200

# Seconds a connectivity check may take, above 0, up to 120. A check's attempts share it: a retry
# happens only if it fits in what is left.
LLM_TIMEOUT_SECONDS=30
# Checks per user per minute (1 to 600) and for everyone per day (1 to 100000).
LLM_CHECKS_PER_USER_PER_MINUTE=5
LLM_CHECKS_GLOBAL_PER_DAY=200
# LLM checks in flight at once per API instance (LLM-05), 1 to 16. Each holds a server thread.
LLM_MAX_CONCURRENT_CHECKS=4

# Bounds on /integrations checks; each check may call an external service. Per user per minute
# (1 to 600) and for everyone per day (1 to 100000). The per-user bound also caps how many of a
# non-operator's refused attempts are written to the audit log each minute.
DIAGNOSTICS_RUNS_PER_USER_PER_MINUTE=20
DIAGNOSTICS_RUNS_GLOBAL_PER_DAY=1000

# Least seconds between the starts of two runs of one job over GET /api/v1/jobs/<name>, 0 to 3600. A job is
# also never run twice at once: a call that finds it running answers 409, one that comes too soon 429 with
# Retry-After. 0 keeps only the one-at-a-time rule. Lower it only if you schedule a job every minute. The
# command line (`python -m app.cli job <name>`) is not limited.
JOB_MIN_SPACING_SECONDS=60

# Outbox dispatch: attempts before an event is marked dead (1 to 100), and days processed events are
# kept (1 to 365; they hold internal user IDs).
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETENTION_DAYS=7
# Seconds an event stays leased to the worker running its handlers, 60 to 86400. Keep it longer than
# the platform's maximum function duration (Vercel: 300 s by default, up to 800 s), or a slow handler
# can run twice at once.
OUTBOX_LEASE_SECONDS=900
