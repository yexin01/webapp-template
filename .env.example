# =============================================================================
# Environment configuration — copy to `.env` (git-ignored) and fill in.
#
#   cp .env.example .env
#
# One root `.env` serves both apps: the Python API (apps/api) and the Next.js
# web app (apps/web). Values here are SAFE PLACEHOLDERS ONLY. Use test/sandbox
# keys for local development; live keys are rejected unless APP_ENV=production.
#
# Legend:  [required]  must be set for local development
#          [mode]      required only when the matching *_MODE enables it
#          [optional]  has a sensible default
#          (public)    exposed to the browser bundle — never put secrets here
#          (server)    server-only — never prefix with NEXT_PUBLIC_
#
# Integration modes (spec §5.2):
#   mock     deterministic in-process fake, no network (default for tests)
#   sandbox  provider test mode / non-production project (use for local dev)
#   live     production credentials — only valid when APP_ENV=production
#   disabled telemetry off (analytics and error reporting only)
# See docs/integrations.md for how to obtain each value and configure callbacks.
# =============================================================================

# --- Application ------------------------------------------------------------
# [required] local | test | preview | production
APP_ENV=local
# [required] (server) Public URL of the web app; used to build redirect URLs.
APP_BASE_URL=http://localhost:3000
# [optional] (server) Where the web app forwards /api/v1/* (read at build time).
API_ORIGIN=http://127.0.0.1:8000
# [optional] (server) DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# [optional] (server) Maximum JSON request body in bytes (spec §15.3).
MAX_REQUEST_BODY_BYTES=1000000

# --- Database (PostgreSQL / Supabase) ----------------------------------------
# [required] (server) Local default matches docker-compose.yml (local-only credentials).
# For hosted Supabase use the pooled connection string of a NON-production project.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/app
# [optional] (server) Per-process pools: request work (app_api) and system work
# such as webhooks, jobs, and rate limits (app_worker). Separate pools mean
# requests can never starve system work, or the reverse.
DATABASE_POOL_MAX_SIZE=5
DATABASE_WORKER_POOL_MAX_SIZE=3
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=10000

# --- Clerk (authentication + organizations) -----------------------------------
# [required] (public) Development instance publishable key: pk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# [required] (server) Development instance secret key: sk_test_...
CLERK_SECRET_KEY=sk_test_replace_me
# [required] (server) Comma-separated origins allowed in the token `azp` claim.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# [optional] (server) PEM public key for networkless token verification.
# When empty, keys are fetched from the instance JWKS endpoint.
CLERK_JWT_KEY=
# [optional] (server) Signing secret of the Clerk webhook endpoint (whsec_...).
# Enables immediate membership revocation; without it, memberships are
# re-verified once older than MEMBERSHIP_MAX_STALENESS_SECONDS.
CLERK_WEBHOOK_SIGNING_SECRET=
# [optional] (server) Approved default: 300 s (DEC-009, ADR-0002).
MEMBERSHIP_MAX_STALENESS_SECONDS=300
# [optional] (server) Users re-verified per run of the reconcile-memberships job.
MEMBERSHIP_RECONCILE_BATCH_SIZE=50

# --- Stripe (billing) ----------------------------------------------------------
# [required] mock | sandbox | live
BILLING_MODE=mock
# [mode] (server) Test-mode secret or restricted key: sk_test_... / rk_test_...
STRIPE_SECRET_KEY=
# [mode] (server) Signing secret for /api/v1/webhooks/stripe in THIS environment.
STRIPE_WEBHOOK_SECRET=
# [mode] (server) Recurring prices for the Pro plan (price_...).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# [optional] (server)
CHECKOUTS_PER_USER_PER_HOUR=10
# [optional] (server) true: the scheduled reconcile-billing job applies Stripe's
# state when it finds a divergence. false (default): it only reports.
BILLING_RECONCILE_APPLY=false
# [optional] (server) Customers checked per run of the reconcile-billing job (one
# Stripe call each), least recently checked first. Keep a run well inside the
# platform's function duration limit.
BILLING_RECONCILE_BATCH_SIZE=200

# --- LLM provider (connectivity check only) -----------------------------------
# [required] mock | sandbox | live
LLM_MODE=mock
# [mode] (server) anthropic | openai
LLM_PROVIDER=anthropic
# [mode] (server) Provider API key. Set a spending limit at the provider.
LLM_API_KEY=
# [mode] (server) Model ID to verify, as named by the provider.
LLM_MODEL=
# [optional] (server)
LLM_TIMEOUT_SECONDS=30
LLM_CHECKS_PER_USER_PER_MINUTE=5
LLM_CHECKS_GLOBAL_PER_DAY=200
# [optional] (server) LLM checks in flight at once per API instance (LLM-05).
LLM_MAX_CONCURRENT_CHECKS=4

# --- PostHog (product analytics) -----------------------------------------------
# [required] disabled | sandbox | live
ANALYTICS_MODE=disabled
# [mode] (public) Project API key (phc_...) of a NON-production project.
NEXT_PUBLIC_POSTHOG_KEY=
# [optional] (public) https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (error monitoring) -------------------------------------------------
# [required] disabled | sandbox | live
ERROR_REPORTING_MODE=disabled
# [mode] (server) DSN of the API project.
SENTRY_DSN=
# [mode] (public) DSN of the web project (DSNs are not secrets but identify your project).
NEXT_PUBLIC_SENTRY_DSN=
# [optional] (server) 0.0 - 1.0
SENTRY_TRACES_SAMPLE_RATE=0
# [optional] (server, CI only) Enables source-map upload during builds.
SENTRY_AUTH_TOKEN=

# --- Integration diagnostics (/integrations page) -----------------------------
# [optional] (server) true | false. Empty = enabled everywhere except production.
# The page runs authenticated checks against every configured service.
DIAGNOSTICS_ENABLED=
# [optional] (server) Comma-separated Clerk user IDs (user_...) allowed to use
# diagnostics. Empty: any signed-in user when APP_ENV=local; nobody elsewhere.
DIAGNOSTICS_OPERATOR_IDS=
# [optional] (server) Bounds on checks; each check may call an external service.
DIAGNOSTICS_RUNS_PER_USER_PER_MINUTE=20
DIAGNOSTICS_RUNS_GLOBAL_PER_DAY=1000

# --- Jobs and domain events --------------------------------------------------
# [optional] (server) Bearer secret that Vercel Cron sends to /api/v1/jobs/<name>
# (at least 32 characters, e.g. `openssl rand -hex 32`). Empty: the job
# endpoint is off; run jobs with `uv run python -m app.cli job <name>`.
CRON_SECRET=
# [optional] (server) Outbox dispatch: events per batch, attempts before an event
# is marked dead, and days processed events are kept (they hold internal user IDs).
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETENTION_DAYS=7

# --- End-to-end tests (sandbox only; never real user accounts) ---------------
# E2E_SANDBOX=1
# E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com
# E2E_CLERK_USER_PASSWORD=
