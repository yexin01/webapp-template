# =============================================================================
# Environment configuration — copy to `.env` (git-ignored) and fill in.
#
#   cp .env.example .env
#
# One root `.env` serves both apps: the Python API (apps/api) and the Next.js
# web app (apps/web). Values here are SAFE PLACEHOLDERS ONLY. Use test/sandbox
# keys for local development; live keys are rejected unless APP_ENV=production.
# Only this file is read: not .env.local, .env.development*, .env.production*, .env.test*,
# or apps/web/.env* (the web build refuses them, naming the files). Restart `pnpm dev`
# after editing it (neither server reloads it). To pull values from Vercel, run
# `vercel env pull .env` at the repository root.
#
# Legend:  [required]  must be set for local development
#          [mode]      required only when the matching *_MODE enables it
#          [optional]  has a sensible default
#          (public)    exposed to the browser bundle — never put secrets here
#          (server)    server-only — never prefix with NEXT_PUBLIC_
#
# Integration modes (spec §5.2):
#   mock     deterministic in-process fake, no network (default for tests)
#   sandbox  provider test mode / non-production project (use for local dev)
#   live     production credentials — only valid when APP_ENV=production
#   disabled off: no provider is called (analytics, error reporting, and the LLM check)
# See docs/integrations.md for how to obtain each value and configure callbacks.
# =============================================================================

# --- Application ------------------------------------------------------------
# [required] local | test | preview | production
# On Vercel, an unset APP_ENV is taken from VERCEL_ENV (production, preview; development is
# local), and a value that contradicts it is refused: never import this local file into a
# Vercel project (APP_ENV=local is refused there), and production values belong to the
# Production scope only. Preview and production deployments must also set the integration
# modes (BILLING_MODE, LLM_MODE, ANALYTICS_MODE, ERROR_REPORTING_MODE) explicitly.
APP_ENV=local
# [required] (server) Public URL of the web app (scheme, host, optional port; no path):
# the CORS origin and the base of Stripe redirect URLs. Required when APP_ENV is preview
# or production (https in production); local and test default to this value.
APP_BASE_URL=http://localhost:3000
# [optional] (server) Where the web app forwards /api/v1/* (read at build time).
# Must use https when APP_ENV=production, unless it is this machine (localhost, 127.x.x.x, [::1]).
API_ORIGIN=http://127.0.0.1:8000
# [optional] (server) DEBUG | INFO | WARNING | ERROR | CRITICAL, in any case
LOG_LEVEL=INFO
# [optional] (server) Maximum JSON request body in bytes (spec §15.3).
MAX_REQUEST_BODY_BYTES=1000000

# --- Database (PostgreSQL / Supabase) ----------------------------------------
# [required] (server) Local default matches docker-compose.yml (local-only credentials).
# For hosted Supabase use the pooled connection string of a NON-production project.
# Percent-encode special characters in the password: startup refuses a URL that
# does not parse cleanly.
# In preview and production this must be the app_login role (pnpm db:api-login),
# never the schema owner (Supabase's postgres): the API refuses a login role that
# is a superuser, has BYPASSRLS, or owns the app tables. Connections to a
# non-local host use TLS (sslmode=require) unless the URL sets sslmode.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/app
# [optional] (server) The schema owner, for pnpm db:migrate, db:seed, db:reset and
# db:api-login. Empty: DATABASE_URL is used. Never set it where the API runs.
MIGRATION_DATABASE_URL=
# [optional] (server) Per-process pools: request work (app_api) and system work
# (app_worker: webhooks, jobs, rate limits, readiness, and event dispatch after
# the response). Requests use worker connections too, so the pools do not keep
# the two kinds of work apart; they keep a request that holds a request
# connection from waiting on its own pool. Worker pool 2 to 10 (billing
# synchronization uses all but one); request pool at least 1; both within the
# thread budget below.
# Thread budget: each API process has 40 request threads, held by admitted
# requests (DATABASE_POOL_MAX_SIZE), by bounded external work
# (DATABASE_WORKER_POOL_MAX_SIZE - 1 + LLM_MAX_CONCURRENT_CHECKS +
# BILLING_MAX_CONCURRENT_STRIPE_CALLS + CLERK_MAX_CONCURRENT_READS, plus 5 for
# Clerk key-set lookups while CLERK_JWT_KEY is empty), and by calls waiting for
# a connection, which get what is left: 12 with these defaults, 17 with
# CLERK_JWT_KEY set. Startup refuses settings that leave fewer than 8. Not
# counted, because no limit caps them, though they hold threads while they run:
# operator diagnostics, cron job runs, and Clerk key-set lookups while no usable
# key set is cached.
DATABASE_POOL_MAX_SIZE=5
DATABASE_WORKER_POOL_MAX_SIZE=3
# [optional] (server) Also the longest a request waits for its turn at the
# database before it gets a 503, and the longest event dispatch after a
# response waits for a free slot (past that, drain-outbox delivers the events).
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=10000

# --- Clerk (authentication + organizations) -----------------------------------
# [required] (public) Development instance publishable key: pk_test_...
# These two ship as a well-formed but fake pair that means "Clerk is not configured":
# builds, tests and `pnpm check:setup` work with them, `pnpm dev` asks for your keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsubm90LWNvbmZpZ3VyZWQteWV0LmludmFsaWQk
# [required] (server) Development instance secret key: sk_test_...
CLERK_SECRET_KEY=sk_test_clerk_not_configured_yet
# [optional] (server) Comma-separated origins allowed in the token `azp` claim, as a
# browser sends them (scheme, host, optional port; no path). Empty: the origin of
# APP_BASE_URL, which must be listed here when this is set. On a Vercel preview deployment
# (APP_ENV=preview and VERCEL_ENV=preview) the deployment's own URL and its branch URL are
# trusted in addition; production never adds any. The web app applies the same list in its
# proxy (it reads this and APP_BASE_URL when it is built, so rebuild after changing them).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# [optional] (server) PEM public key for networkless token verification.
# When empty, keys are fetched from the instance JWKS endpoint.
CLERK_JWT_KEY=
# [optional] (server) Signing secret of the Clerk webhook endpoint (whsec_...).
# Enables immediate membership revocation; without it, memberships are
# re-verified once older than MEMBERSHIP_MAX_STALENESS_SECONDS.
CLERK_WEBHOOK_SIGNING_SECRET=
# [optional] (server) true | false. Sessions someone else started as a user (Clerk
# dashboard impersonation, actor tokens, agent tasks; the token has an `act` claim)
# get 403 unless this is true. When true, each audit entry written during one names
# the actor (app.audit_log.impersonator_clerk_id) and the logs record it.
CLERK_ALLOW_IMPERSONATION=false
# [optional] (server) Clerk membership reads in flight per instance (3-16), counting
# requests that wait for another request's read. Two requests may always wait for
# one read; more only while over a quarter of these slots stay free. Each holds a
# server thread until Clerk answers. Past the limit, a request that needs a read
# gets 503 at once, and a membership webhook gets 503, so Clerk retries it.
CLERK_MAX_CONCURRENT_READS=8
# [optional] (server) Approved bound: 300 s (DEC-009, ADR-0002). Lower values are
# allowed; higher ones are rejected.
MEMBERSHIP_MAX_STALENESS_SECONDS=300
# [optional] (server) Users re-verified per run of the reconcile-memberships job.
MEMBERSHIP_RECONCILE_BATCH_SIZE=50

# --- Stripe (billing) ----------------------------------------------------------
# [required] mock | sandbox | live
BILLING_MODE=mock
# [mode] (server) Test-mode secret or restricted key: sk_test_... / rk_test_...
STRIPE_SECRET_KEY=
# [mode] (server) Signing secret for /api/v1/webhooks/stripe in THIS environment.
STRIPE_WEBHOOK_SECRET=
# [mode] (server) Recurring prices for the Pro plan (price_...).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# [optional] (server) Comma-separated prices you no longer sell that still grant Pro
# to existing subscribers. When you change a price above, add the old one here.
STRIPE_PRICE_PRO_MONTHLY_RETAINED=
STRIPE_PRICE_PRO_YEARLY_RETAINED=
# [optional] (server, read by the API and the web app) Your Stripe custom domain for
# Checkout and the Customer Portal, e.g. payments.example.com. Live mode only. Set it and
# deploy BEFORE the domain goes live in Stripe: Stripe switches to it once its DNS verifies.
STRIPE_CUSTOM_DOMAIN=
# [optional] (server)
CHECKOUTS_PER_USER_PER_HOUR=10
# [optional] (server) Customer-portal sessions per user per hour, 1 to 1000. Each is a
# Stripe API call, and Stripe rate-limits the whole account.
PORTAL_SESSIONS_PER_USER_PER_HOUR=20
# [optional] (server) Re-reads from Stripe per user per hour, 1 to 1000. The billing page
# asks for one after checkout and after the Customer Portal, in case the webhook is late.
# A re-read counts against BILLING_MAX_CONCURRENT_STRIPE_CALLS below and never takes the last
# of the DATABASE_WORKER_POOL_MAX_SIZE - 1 synchronization slots, which webhooks keep.
BILLING_SYNCS_PER_USER_PER_HOUR=30
# [optional] (server) Checkout and portal requests calling Stripe at once per API
# instance, 1 to 16. Each holds a server thread until Stripe answers; past the bound,
# checkout and the portal answer 503 at once instead of queueing.
BILLING_MAX_CONCURRENT_STRIPE_CALLS=4
# [optional] (server) true: the scheduled reconcile-billing job applies Stripe's
# state when it finds a divergence. false (default): it only reports.
BILLING_RECONCILE_APPLY=false
# [optional] (server) Customers checked per run of the reconcile-billing job (one
# Stripe call each), least recently checked first. Keep a run well inside the
# platform's function duration limit.
BILLING_RECONCILE_BATCH_SIZE=200

# --- LLM provider (connectivity check only) -----------------------------------
# [required] disabled | mock | sandbox | live. disabled calls no provider and needs no key
# (allowed everywhere; the check answers "not configured"); production allows disabled or live.
LLM_MODE=mock
# [mode] (server) anthropic | openai
LLM_PROVIDER=anthropic
# [mode] (server) Provider API key. Set a spending limit at the provider.
LLM_API_KEY=
# [mode] (server) Model ID to verify, as named by the provider.
LLM_MODEL=
# [optional] (server)
LLM_TIMEOUT_SECONDS=30
LLM_CHECKS_PER_USER_PER_MINUTE=5
LLM_CHECKS_GLOBAL_PER_DAY=200
# [optional] (server) LLM checks in flight at once per API instance (LLM-05), 1 to 16.
# Each holds a server thread. A check's attempts share LLM_TIMEOUT_SECONDS: a retry
# happens only if it fits in what is left.
LLM_MAX_CONCURRENT_CHECKS=4

# --- PostHog (product analytics) -----------------------------------------------
# [required] disabled | sandbox | live
ANALYTICS_MODE=disabled
# [mode] (public) Project token (phc_..., Project settings) of a NON-production project,
# never a personal (phx_) or secret (phs_) key: it ships in every browser bundle and is
# refused when it is not a project token. PostHog's Next.js guide names this variable
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN; this template reads NEXT_PUBLIC_POSTHOG_KEY.
NEXT_PUBLIC_POSTHOG_KEY=
# [optional] (public) https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (error monitoring) -------------------------------------------------
# [required] disabled | sandbox | live
ERROR_REPORTING_MODE=disabled
# [mode] (server) DSN of the API project.
SENTRY_DSN=
# [mode] (public) DSN of the web project (DSNs are not secrets but identify your project).
NEXT_PUBLIC_SENTRY_DSN=
# [optional] (server) 0.0 - 1.0. At 0 the API sends no traces, not even for a request whose caller sent a sampled
# trace; its error events still carry the caller's trace ID. Above 0 the API samples each request a page makes at
# this rate: the browser sends no sampling decision and records no spans.
SENTRY_TRACES_SAMPLE_RATE=0
# [optional] (server) Release that API error events are tagged with. When unset:
# VERCEL_GIT_COMMIT_SHA on Vercel, otherwise sentry-sdk's default (the git commit).
SENTRY_RELEASE=
# [optional] (build only) Enables source-map upload during `next build`. Set it, with
# SENTRY_PROJECT, in the web project's build environment (Vercel or CI); it is not read from
# this file. An organization auth token (sntrys_...) carries its organization.
SENTRY_AUTH_TOKEN=
# [optional] (build only) Slug of the web Sentry project; required with SENTRY_AUTH_TOKEN.
SENTRY_PROJECT=
# [optional] (build only) Sentry organization slug; required with a personal auth token.
SENTRY_ORG=

# --- Integration diagnostics (/integrations page) -----------------------------
# [optional] (server) true | false. Empty = enabled everywhere except production.
# The page runs authenticated checks against every configured service.
DIAGNOSTICS_ENABLED=
# [optional] (server) Comma-separated Clerk user IDs (user_...) allowed to use
# diagnostics. Empty: any signed-in user when APP_ENV=local; nobody elsewhere.
DIAGNOSTICS_OPERATOR_IDS=
# [optional] (server) Bounds on checks; each check may call an external service.
# The per-user bound also caps how many of a non-operator's refused attempts are
# written to the audit log each minute.
DIAGNOSTICS_RUNS_PER_USER_PER_MINUTE=20
DIAGNOSTICS_RUNS_GLOBAL_PER_DAY=1000

# --- Jobs and domain events --------------------------------------------------
# [optional] (server) Bearer secret that Vercel Cron sends to /api/v1/jobs/<name>
# (at least 32 characters, e.g. `openssl rand -hex 32`). Empty: the job
# endpoint is off; run jobs with `uv run python -m app.cli job <name>`.
CRON_SECRET=
# [optional] (server) Outbox dispatch: attempts before an event is marked dead,
# and days processed events are kept (they hold internal user IDs).
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETENTION_DAYS=7
# [optional] (server) Seconds an event stays leased to the worker running its
# handlers. Keep it longer than the platform's maximum function duration
# (Vercel: 300 s by default, up to 800 s), or a slow handler can run twice at once.
OUTBOX_LEASE_SECONDS=900

# --- End-to-end tests (sandbox only; never real user accounts) ---------------
# The sandbox suite runs with `E2E_SANDBOX=1 pnpm test:e2e` (or `pnpm verify:sandbox`). The switch is read
# from the command line only, never from this file. The suite uses the Clerk development keys above (a
# production key is refused) and creates its test user in that instance on the first run: no password.
# [optional] A Clerk test address (it must contain +clerk_test); this is the default.
# E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com
